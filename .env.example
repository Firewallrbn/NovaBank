# Copiar a .env para ajustar parámetros de la simulación (todos opcionales).

# Reglas del servicio de riesgo, en centavos (400.000,00 y 800.000,00)
RISK_MAX_SINGLE_TRANSFER_CENTS=40000000
RISK_DAILY_LIMIT_CENTS=80000000

# Segundos que la pasarela espera a la red interbancaria simulada antes de declarar timeout
CLEARING_NETWORK_TIMEOUT_SECONDS=3

# URLs públicas que el frontend usa para enlazar a las consolas
PREFECT_UI_URL=http://localhost:4200
RABBITMQ_UI_URL=http://localhost:15672
